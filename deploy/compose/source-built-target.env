# Source-built allinone/gateway target-port deployment.
#
# Build the images first from ibiz-service-hub/scripts/build-local-images.sh.
# This file deliberately publishes the local images on the formal service
# ports; use docker-compose-platform-local.yml with this env file only when
# the formal allinone/gateway containers are stopped.
IBIZ_LOCAL_VERSION=8.1.0.584.1
IBIZ_LOCAL_ALLINONE_IMAGE=aibiz/ibiz-ebsx-allinone-rt:8.1.0.584.1-local
IBIZ_LOCAL_GATEWAY_IMAGE=aibiz/ibiz-ebsx-gateway:8.1.0.584.1-local
IBIZ_LOCAL_ALLINONE_PORT=30000
IBIZ_LOCAL_GATEWAY_PORT=30086

# ARM64 digest recorded by the source-built backend receipt.
IBIZ_JAVA_IMAGE=eclipse-temurin@sha256:bc033b57e11b773c3043babfd664e7a5ef110805548b921cbfc3e8c67a0725d6
